# ============================================================================
# MTBots —— 三个 Bot 合并后的统一配置
# 复制为 .env 后按需填写。**三家旧 bot 的环境变量名都兼容**，旧的 .env 可以直接搬。
# 启动前先自检：python -m mtbots --check
# ============================================================================

# ===== Telegram（必填，四选一）=====
# 正式切换时建议换一个新 token，避免旧 bot 还在轮询同一个 token 造成 409 冲突
MTBOTS_BOT_TOKEN=
# 兼容旧名：TELEGRAM_BOT_TOKEN（ClinePass）/ BOT_TOKEN（LDMG）/ TG_BOT_TOKEN（LitePan）
# TELEGRAM_BOT_TOKEN=
# BOT_TOKEN=
# TG_BOT_TOKEN=

# 白名单（必填；默认拒绝，留空 = 任何人都不能用）。多个用逗号分隔，用 /id 查询自己的 ID
ALLOWED_USER_IDS=
# 兼容旧名：TG_ALLOWED_IDS（LitePan）

# 可选：自建 Telegram API 镜像（大陆网络）
# TG_API_BASE=https://api.telegram.org

# ===== 通用 =====
# 启用哪些模块（默认三个全开）
MTBOTS_MODULES=docker,litepan,cline
# 角色覆盖，逗号分隔（默认：白名单内所有人都是 owner）
# MTBOTS_ROLES=123456789:owner
# MTBOTS_DEFAULT_ROLE=owner
# MTBOTS_ALLOW_UNLISTED=0        # 置 1 = 危险：白名单为空时允许所有人（不建议）
DATA_DIR=data
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ===== 🐳 Docker 模块（原 LDMG）=====
# 主面板每页项目数
PAGE_SIZE=6
# 单个 compose 命令超时（秒）
# COMMAND_TIMEOUT=300
# 项目扫描缓存（秒）
# PROJECTS_CACHE_TTL=15
# 滚动审计日志目录（默认在 DATA_DIR/logs）
# LOG_DIR=data/logs

# ===== 🎬 LitePan 模块（原 LitePan-TGBot）=====
# 多用户模式：按 chat_id 绑定各自的 LitePan 实例与「盘名 -> 事件」映射。
# 复制 users.example.json 为 data/litepan-users.json 并编辑；配了就忽略下面的 LITEPAN_* 单用户配置。
LITEPAN_USERS_FILE=data/litepan-users.json

# 单用户模式（不配 users.json 时）：
LITEPAN_URL=
LITEPAN_API_KEY=
LITEPAN_FALLBACK_EVENT=tg_refresh
LITEPAN_SOURCE=telegram
LITEPAN_DEFAULT_PATH=/
# 盘名 -> 事件 映射，两种格式都行：
# DRIVES=光鸭-A:quarkA_refresh,123-A:123A_refresh
# DRIVES={"光鸭-A":"quarkA_refresh","123-A":"123A_refresh"}
DRIVES=
# 回执模式（配置管理员账号后自动开启「自动发现」，/info 直接读盘名与规则名）
LITEPAN_ADMIN_USER=
LITEPAN_ADMIN_PASSWORD=
# 隐私：默认不显示 LitePan 地址
SHOW_LITEPAN_URL=0
# 命令菜单里动态规则命令的预算（Telegram 全局限 100 条，三个模块共享）
LITEPAN_MENU_BUDGET=30
# 后台探测 LitePan 的超时与回执轮询参数
# LITEPAN_TIMEOUT=15
# TG_RECEIPT_POLL_SECONDS=5
# TG_RECEIPT_TIMEOUT_SECONDS=1800

# ===== 🤖 Cline 模块（原 ClinePass-TG-Bot）=====
CLINEPASS_API_BASE=https://api.cline.bot
CLINEPASS_USAGE_PATH=/api/v1/users/me/plan/usage-limits
REQUEST_TIMEOUT=12
HTTP_RETRIES=2
RETRY_BACKOFF=1.5
MAX_PARALLEL=4
MAX_KEYS_PER_USER=10
STATUS_COOLDOWN=5
# 演示模式：不请求额度接口，用示例数字渲染面板（截图/开发用）
DEMO_MODE=0
# 是否在面板里显示账号邮箱/名字（默认不显示）
SHOW_IDENTITY=0
# 单条消息最大长度（Telegram 上限 4096）
MESSAGE_LIMIT=3800
